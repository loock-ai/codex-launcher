{
  "manifestVersion": 2,
  "id": "mobile",
  "name": "Mobile",
  "description": "手机 Web、Dots 与 Desktop 控制网关",
  "version": "1.0.0",
  "launcherApiVersion": "1",
  "defaultEnabled": true,
  "autoStartDefault": true,
  "entrypoints": {"main": "main.cjs", "ui": "ui/index.html"},
  "permissions": ["desktop.control", "desktop.discoverCli", "service.listen", "process.spawn", "system.openExternal", "clipboard.write"],
  "pages": [{"id": "mobile", "title": "Mobile"}],
  "actions": [{"id": "open-web", "title": "打开 Web"}]
}
