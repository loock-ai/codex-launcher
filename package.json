{
  "name": "codex-mobile",
  "version": "0.2.0",
  "description": "Mobile-first web client and gateway for Codex app-server",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "codex-mobile": "bin/codex-mobile.mjs"
  },
  "files": [
    "bin",
    "dist",
    "npm-dist/server",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loock-ai/codex-mobile.git"
  },
  "homepage": "https://github.com/loock-ai/codex-mobile#readme",
  "bugs": {
    "url": "https://github.com/loock-ai/codex-mobile/issues"
  },
  "keywords": [
    "codex",
    "mobile",
    "app-server",
    "gateway"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "zsh -lc 'source \"${CODEX_MOBILE_ENV_FILE:-$HOME/Library/Application Support/CodexMobileWeb/gateway.env}\" && exec npm exec -- concurrently --kill-others --success first --names gateway,vite \"npm:dev:gateway\" \"npm:dev:web\"'",
    "dev:gateway": "NODE_ENV=development CODEX_MOBILE_SERVE_STATIC=false tsx watch server/index.ts",
    "dev:web": "NODE_ENV=development vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.npm.json",
    "build:package": "npm run build && npm run build:server",
    "prepack": "npm run build:package",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --pretty false",
    "launcher": "tauri dev",
    "build:launcher": "npm run build:package && node scripts/build-mobile-plugin.mjs && node scripts/build-launcher.mjs",
    "package:launcher": "tauri build",
    "launcher:electron": "electron launcher/main.cjs",
    "package:electron": "npm run build:launcher && electron-builder --mac --dir",
    "build:tauri": "node scripts/build-tauri.mjs",
    "tauri": "tauri",
    "package:tauri": "tauri build"
  },
  "dependencies": {
    "playwright-core": "^1.63.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/cli": "^2.12.2",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "ajv": "^8.17.1",
    "concurrently": "^10.0.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^27.2.0",
    "qr-scanner": "^1.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.13",
    "yaml": "^2.9.0"
  }
}
